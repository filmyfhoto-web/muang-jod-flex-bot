# เริ่มทดสอบในโหมดจำลองก่อนเสมอ
DEMO_MODE=true
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# LINE Messaging API — ใส่เฉพาะตอนผ่าน TEST แล้ว
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
