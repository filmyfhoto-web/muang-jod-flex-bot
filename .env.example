# Server
PORT=3000

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase — Project URL เท่านั้น เช่น https://abcdefghijkl.supabase.co
# (ถ้าเผลอใส่ .../rest/v1 มา ระบบตัดให้เอง แต่ควรใส่ให้ถูก)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rich Menu Image
RICH_MENU_IMAGE_PATH=./assets/rich-menu.png

# (ไม่บังคับ) รหัสผ่านหน้าตั้งค่าเจ้าของบอต — ติดตั้ง Rich Menu ได้จากเบราว์เซอร์
# ไม่ต้องใช้ Terminal เปิด https://<โดเมนบอต>/admin/rich-menu
# เบราว์เซอร์จะขึ้นช่องให้กรอกรหัส (ชื่อผู้ใช้ปล่อยว่าง ใส่ค่านี้ในช่องรหัสผ่าน)
# ต้องยาวอย่างน้อย 16 ตัวอักษร ถ้าไม่ใส่ หน้านี้จะปิด (ขึ้น 404)
ADMIN_TOKEN=

# (ไม่บังคับ) กุญแจของ "ใบเสร็จโหมดร้าน" — ใบเดียวกับที่ลูกค้าเปิด แต่มีราคาจริง
# ก่อนร้านปัดอยู่ด้วย ไม่ตั้งก็ใช้ LINE_CHANNEL_SECRET แทนอัตโนมัติ
RECEIPT_SHOP_SECRET=

# (ไม่บังคับ) LIFF — หน้าจัดการงานในเว็บแอปภายใน LINE
# สร้างที่ LINE Developers > LINE Login channel > LIFF > Add
#   Endpoint URL = https://<โดเมนบอต>/app   |   Size = Full   |   Scope = profile, openid
# ถ้าไม่ใส่ ปุ่ม "แก้ไข" จะกลับไปใช้การแก้ผ่านแชตแทน
LIFF_ID=

# (ไม่บังคับ) ฟอร์ม "จดด่วน" แบบการ์ดเด้งทับแชต
# ขนาดของ LIFF ผูกกับ LIFF ID ไม่ใช่ URL การ์ดเด้งจึงต้องเป็น LIFF app อีกตัว
# สร้างเพิ่มอีกอันใน LINE Login channel เดิม แล้วตั้ง
#   Endpoint URL = https://<โดเมนบอต>/app/jot?quick=1   |   Size = Tall
# ไม่ใส่ก็ยังเปิดฟอร์มเดิมได้ แค่เป็นแบบเต็มหน้าจอแทนการ์ดเด้ง
LIFF_ID_QUICK=

# (ไม่บังคับ) โดเมนสาธารณะของบอต ใช้ประกอบ URL รูปแบรนด์
# บน Render ไม่ต้องใส่ (ระบบใช้ RENDER_EXTERNAL_URL ให้เอง)
PUBLIC_BASE_URL=

# Uploads (สลิป/หลักฐาน) — จำกัดขนาดไฟล์ต่อไฟล์ (MB)
MAX_UPLOAD_MB=10

# กันโฮสต์หลับ (Render free tier หลับหลังไม่มีคนเรียก ~15 นาที)
# บอตจะ ping /health ตัวเองทุก 10 นาที ใส่ 0 เพื่อปิด
KEEP_ALIVE=
# ปิงเฉพาะช่วงเวลานี้ (เวลาไทย) ค่าเริ่มต้น 6-23
# แพลนฟรีของ Render ให้ 750 ชม./เดือน ปิงทั้งวันใช้ ~720 ชม. เกือบเต็มโควตา
# 6-23 ใช้ ~510 ชม. ตอบไวช่วงที่ใช้งานจริง ส่วนดึกๆ ข้อความแรกจะช้า ~50 วิ
# ใส่ 0-24 ถ้าอยากให้ตื่นตลอด 24 ชม.
KEEP_ALIVE_HOURS=

# Logging: debug | info | warn | error (ค่าเริ่มต้น info)
LOG_LEVEL=info

# บอตจะบอกสาเหตุจริงต่อท้ายข้อความ "ระบบมีปัญหาชั่วคราว" (เปิดอยู่โดยค่าเริ่มต้น)
# ใส่ 0 เพื่อปิด เมื่อมีผู้ใช้อื่นนอกจากเจ้าของบอต
DEBUG_ERRORS=

# (ไม่บังคับ) รูปน้องหมาม่วงจด (https, สี่เหลี่ยมจัตุรัส) โชว์ในการ์ดใบเสร็จ
# ถ้าวางไฟล์ไว้ที่ public/brand/mascot.png ใช้ URL ของบอตได้เลย เช่น
# https://<โดเมนบอต>/brand/mascot.png
BRAND_MASCOT_IMAGE_URL=
# (ไม่บังคับ) รูปแบนเนอร์เต็มความกว้างบนหัวการ์ด
BRAND_HERO_IMAGE_URL=

# (ไม่บังคับ) เปิดการอ่านภาษาธรรมชาติด้วย Claude — ถ้าไม่ใส่ ระบบใช้ตัวแยกคำแบบ rule-based
ANTHROPIC_API_KEY=
# โมเดลสำหรับแยกข้อความ (ค่าเริ่มต้น claude-haiku-4-5 — เร็ว เหมาะกับ webhook)
NLP_MODEL=claude-haiku-4-5
# (ไม่บังคับ) โมเดลสำหรับอ่านรูปสลิป/ใบสั่งงาน ถ้าไม่ใส่ใช้ค่าเดียวกับ NLP_MODEL
# ต้องมี ANTHROPIC_API_KEY ด้วย ไม่งั้นรูปจะถูกแนบเข้างานล่าสุดเหมือนเดิม
VISION_MODEL=
