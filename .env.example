# Server
PORT=3000

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase — Project URL เท่านั้น เช่น https://abcdefghijkl.supabase.co
# (ถ้าเผลอใส่ .../rest/v1 มา ระบบตัดให้เอง แต่ควรใส่ให้ถูก)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rich Menu Image
RICH_MENU_IMAGE_PATH=./assets/rich-menu.png

# Uploads (สลิป/หลักฐาน) — จำกัดขนาดไฟล์ต่อไฟล์ (MB)
MAX_UPLOAD_MB=10

# Logging: debug | info | warn | error (ค่าเริ่มต้น info)
LOG_LEVEL=info

# บอตจะบอกสาเหตุจริงต่อท้ายข้อความ "ระบบมีปัญหาชั่วคราว" (เปิดอยู่โดยค่าเริ่มต้น)
# ใส่ 0 เพื่อปิด เมื่อมีผู้ใช้อื่นนอกจากเจ้าของบอต
DEBUG_ERRORS=

# (ไม่บังคับ) รูปน้องหมาม่วงจด (https, สี่เหลี่ยมจัตุรัส) โชว์ในการ์ดใบเสร็จ
# ถ้าวางไฟล์ไว้ที่ public/brand/mascot.png ใช้ URL ของบอตได้เลย เช่น
# https://<โดเมนบอต>/brand/mascot.png
BRAND_MASCOT_IMAGE_URL=
# (ไม่บังคับ) รูปแบนเนอร์เต็มความกว้างบนหัวการ์ด
BRAND_HERO_IMAGE_URL=

# (ไม่บังคับ) เปิดการอ่านภาษาธรรมชาติด้วย Claude — ถ้าไม่ใส่ ระบบใช้ตัวแยกคำแบบ rule-based
ANTHROPIC_API_KEY=
# โมเดลสำหรับแยกข้อความ (ค่าเริ่มต้น claude-haiku-4-5 — เร็ว เหมาะกับ webhook)
NLP_MODEL=claude-haiku-4-5
