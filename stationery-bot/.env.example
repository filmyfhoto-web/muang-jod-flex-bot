LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
PORT=3000
ANTHROPIC_API_KEY=
SLIP_MODEL=claude-haiku-4-5
# รุ่น AI ที่ใช้อ่านประโยคสั่งของ (เฉพาะเมื่อเปิด chatOrders.ai ใน data/shop.json) — เว้นว่าง = ค่าเริ่มต้นของผู้ให้บริการที่ตั้งคีย์ไว้
CHAT_AI_MODEL=
GEMINI_API_KEY=

# ฟีเจอร์ของแอป NATTA GROUP (การ์ดออเดอร์ · การ์ดเมนู · คุยกับแอดมิน · ส่งเอกสารโครงการ) — เว้นว่าง = ปิด
# ใส่ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามเอาค่าพวกนี้ไปไว้ในโค้ดหรือแชท
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# สะพาน LINE ของหน้า "แชตและออเดอร์" ในหลังร้าน (ข้อความลูกค้าเข้าหน้า · พนักงานตอบจากหน้า) — ปิดไว้ (off) จนกว่าจะตั้ง SALECHAT_MODE
# ใช้คีย์ฐานข้อมูลชุดเดียวกับฟีเจอร์อื่นได้ (CHATDRAFTS_ หรือ SUPABASE_) หรือตั้งชุด SALECHAT_ แยกก็ได้ · คีย์เป็นความลับ ห้ามไว้ในโค้ดหรือแชท
# SALECHAT_MODE: off = ไม่รับไม่ส่ง · pilot = เฉพาะ LINE ที่ระบุใน SALECHAT_PILOT_IDS · on = ลูกค้าทุกคน
SALECHAT_MODE=off
SALECHAT_PILOT_IDS=
SALECHAT_SUPABASE_URL=
SALECHAT_SERVICE_ROLE_KEY=
# การ์ดคำสั่งงานให้ทีมงาน (คนในรายชื่อติดต่อของร้าน) เมื่อบันทึกใบใหม่: off · on — ค่าเริ่มต้น off
SALECHAT_TEAMCARD=off
# การ์ดคำสั่งงานที่ส่งลูกค้า (ปุ่ม "ส่งสรุปให้ลูกค้า" ในหน้า): off = ส่งเป็นข้อความเหมือนเดิม · on = ส่งเป็นการ์ด — ค่าเริ่มต้น off
SALECHAT_CARD=off
